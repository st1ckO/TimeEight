# Browser-safe Supabase configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Feature gates. Public email auth stays off until custom SMTP is configured.
NEXT_PUBLIC_ENABLE_EMAIL_AUTH=false
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Server-only. Required only by the account-deletion route in production.
SUPABASE_SECRET_KEY=

# Configure the Turnstile secret in Supabase Auth CAPTCHA settings, not in the browser app.
